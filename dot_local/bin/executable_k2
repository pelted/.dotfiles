#!/usr/bin/env bash
#
# k2 — helper for the Kolide k2 production Rails console.
#
# Wraps the runbook at:
#   https://app.notion.com/p/1password/Rails-Console-37512a18962f80afbc6adaf789c70b40
#
# Every kubectl call passes --context/--namespace explicitly, so this never
# depends on (or changes) your current kubectx/kubens selection.

set -euo pipefail

NAMESPACE="kolide-k2"
CLUSTER="us"
SUFFIX="1"
FRESH="no"
COMMAND=(bin/rails console)

usage() {
  cat <<EOF
k2 — Kolide k2 prod Rails console helper

Usage:
  k2 console            Show your console pods and this help
  k2 console connect    Create (or reuse) your console pod and open a Rails console
  k2 console status     List all rails-console pods in the namespace
  k2 console cleanup    Delete your console pod

Options (for connect/cleanup):
  -c, --cluster NAME    Cluster: us (default), eu, ca, us2, preview-us, preview-eu, preview-ca
  -s, --suffix N        Pod name suffix, for a second concurrent console (default: 1)
      --fresh           Delete any existing pod first, so you get the latest deployed image
      --shell           Open bash in the pod instead of a Rails console

Good to know:
  - Exiting the console does NOT delete the pod (it idles up to 1 day).
    Run 'k2 console cleanup' when you're done — the runbook asks for this.
  - A reused pod runs the image from when it was CREATED. If a deploy just
    went out and you need the new code, use --fresh.
  - If kubectl suddenly wants auth, your Okta token expired; a browser login
    will pop. Port 8000 must be free for the callback.
EOF
}

context_for_cluster() {
  case "$1" in
    us|eu|ca|us2|preview-us|preview-eu|preview-ca)
      echo "okta@1infra-public-$1-02"
      ;;
    *)
      echo "k2: unknown cluster '$1' (expected us, eu, ca, us2, preview-us, preview-eu, preview-ca)" >&2
      exit 1
      ;;
  esac
}

kc() {
  kubectl --context "$(context_for_cluster "$CLUSTER")" --namespace "$NAMESPACE" "$@"
}

pod_name() {
  echo "rails-console-${USER}-${SUFFIX}"
}

pod_exists() {
  kc get pod "$(pod_name)" >/dev/null 2>&1
}

console_status() {
  echo "Cluster: $(context_for_cluster "$CLUSTER")   Namespace: ${NAMESPACE}"
  echo
  if ! kc get pods -o wide 2>/dev/null | { grep -E '^NAME|^rails-console-' || true; } | grep -q rails-console-; then
    echo "No console pods running."
  else
    kc get pods -o wide | grep -E '^NAME|^rails-console-'
  fi
}

console_connect() {
  local pod
  pod="$(pod_name)"

  if [[ "$FRESH" == "yes" ]] && pod_exists; then
    echo "Deleting existing pod ${pod} (--fresh)..."
    kc delete pod "$pod" --wait
  fi

  if pod_exists; then
    local age
    age="$(kc get pod "$pod" -o jsonpath='{.metadata.creationTimestamp}')"
    echo "Reusing existing pod ${pod} (created ${age})."
    echo "Note: it runs the image deployed at creation time — use --fresh for current code."
  else
    local source_pod
    source_pod="$(kc get pod -l work-group=string-logs -o name | head -n1)"
    if [[ -z "$source_pod" ]]; then
      echo "k2: no string-logs pod found to copy from — wrong cluster, or auth problem?" >&2
      exit 1
    fi
    echo "Creating ${pod} from ${source_pod}..."
    kc debug "$source_pod" \
      --copy-to="$pod" \
      --container=kolide2 \
      --keep-annotations \
      --profile=restricted \
      -- sleep 1d
    kc wait --for=condition=Ready pod "$pod" --timeout 120s
  fi

  echo "Connecting (exit with Ctrl-D; then 'k2 console cleanup' when finished)..."
  kc exec -it "$pod" -- "${COMMAND[@]}"
}

console_cleanup() {
  local pod
  pod="$(pod_name)"
  if pod_exists; then
    kc delete pod "$pod"
  else
    echo "No pod named ${pod} — nothing to clean up."
  fi
}

main() {
  local group="${1:-help}"
  shift || true
  local action="${1:-}"
  [[ $# -gt 0 ]] && shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -c|--cluster) CLUSTER="$2"; shift 2 ;;
      -s|--suffix)  SUFFIX="$2";  shift 2 ;;
      --fresh)      FRESH="yes";  shift ;;
      --shell)      COMMAND=(bash); shift ;;
      -h|--help)    usage; exit 0 ;;
      *)
        echo "k2: unknown option '$1'" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  case "${group} ${action}" in
    "console connect") console_connect ;;
    "console status")  console_status ;;
    "console cleanup") console_cleanup ;;
    "console ")        console_status; echo; usage ;;
    "help "|" ")       usage ;;
    *)
      echo "k2: unknown command '${group} ${action}'" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
