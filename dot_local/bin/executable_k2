#!/usr/bin/env bash
# Shim: the real script lives in the k2 repo so the team shares one copy.
set -euo pipefail

K2_SCRIPT="$HOME/Code/Kolide.nosync/k2/bin/k2"

if [[ ! -x "$K2_SCRIPT" ]]; then
  echo "k2: expected script at $K2_SCRIPT — is the k2 repo cloned?" >&2
  exit 1
fi

exec "$K2_SCRIPT" "$@"
